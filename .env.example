# NVIDIA NIM API Key (Free tier from build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Default Model Configuration
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# Free Gmail SMTP Configuration (Optional for sending live emails)
# Generate App Password at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your-gmail-address@gmail.com
SENDER_PASSWORD=your-16-char-gmail-app-password
